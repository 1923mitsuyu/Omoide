#include "Omoide.base.xcconfig"

ONLY_ACTIVE_ARCH = YES
DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_TESTABILITY = YES

CODE_SIGN_IDENTITY = Apple Development

PRODUCT_BUNDLE_IDENTIFIER = com.ikufumi.Omoide.dev
PROVISIONING_PROFILE_SPECIFIER = match Development $(PRODUCT_BUNDLE_IDENTIFIER)

GCC_OPTIMIZATION_LEVEL = 0
SWIFT_OPTIMIZATION_LEVEL = -Onone
APP_ENVIRONMENT = DEBUG
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(APP_ENVIRONMENT)

//ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev

COPY_PHASE_STRIP = NO
STRIP_INSTALLED_PRODUCT = NO
