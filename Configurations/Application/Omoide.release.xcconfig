#include "Configurations/Application/Omoide.base.xcconfig"

DEVELOPMENT_TEAM =

ONLY_ACTIVE_ARCH = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_TESTABILITY = NO

CODE_SIGN_IDENTITY = Apple Distribution

PRODUCT_BUNDLE_IDENTIFIER =
PROVISIONING_PROFILE_SPECIFIER = match AppStore $(PRODUCT_BUNDLE_IDENTIFIER)

GCC_OPTIMIZATION_LEVEL = s
SWIFT_OPTIMIZATION_LEVEL = -O
APP_ENVIRONMENT = RELEASE
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(APP_ENVIRONMENT)